<launch>

  <arg name="e2e_node_param"  default="$(find-pkg-share e2e_node_py)/config/e2e_node.param.yaml"/>
  <arg name="model_weight" default="$(find-pkg-share e2e_node_py)/ckpts/outside_model.pth"/>
  <arg name="model_architecture" default="large"/>
  <arg name="model_input_dim" default="1080"/>
  <!-- lidar_net_node -->
  <node pkg="e2e_node_py" 
        exec="e2e_node"
        name="e2e_node"
        output="screen">

    <!-- パラメータ -->
    <param from="$(var e2e_node_param)"/>
    <param name="model.weight_path" value="$(var model_weight)"/>
    <param name="model.architecture" value="$(var model_architecture)"/>
    <param name="model.input_dim" value="$(var model_input_dim)"/>
    <!-- トピックのリマッピング -->
    <remap from='/scan' to='/scan'/>
    <remap from='/awsim/control_cmd' to='/awsim/raw_control_cmd'/>
  </node>

</launch>
